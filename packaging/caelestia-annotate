#!/bin/sh
# Open a screenshot in Satty for annotation. Usage: caelestia-annotate <image | ->
# Save (Ctrl+S) writes to $XDG_PICTURES_DIR/Screenshots; copy (Ctrl+C) uses wl-copy.
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir"
exec satty --filename "${1:--}" \
    --output-filename "$dir/%Y%m%d-%H%M%S.png" \
    --copy-command wl-copy \
    --early-exit \
    --floating-hack
